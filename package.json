{
  "name": "space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src e2e scripts *.config.ts",
    "format:check": "prettier --check src e2e scripts *.config.ts",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.90.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "22.19.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.4.2",
    "typescript": "5.4.5"
  }
}
